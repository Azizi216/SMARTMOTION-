# Set these as environment variables before starting FastAPI.
SMARTMOTION_JWT_SECRET=replace-with-a-long-random-secret
SMARTMOTION_FRONTEND_URL=http://localhost:5173
SMARTMOTION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SMTP configuration for automatic patient invitation emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=SmartMotion <no-reply@example.com>

# Local development only. Disable in production.
SMARTMOTION_ENABLE_DEMO_PATIENT=true
